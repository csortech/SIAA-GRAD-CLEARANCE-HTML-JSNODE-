<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Portal Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 450px;">
        <div class="card shadow p-4">
            <h3 class="card-title text-center mb-3">School Portal Login</h3>
            <p class="text-muted text-center small">Sign in to check graduation clearance status</p>

            <form action="/api/login" method="POST">
                <div class="mb-3">
                    <label class="form-label">School Email</label>
                    <input type="email" name="email" class="form-control" placeholder="student@school.edu.ph" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Sign In</button>
            </form>

            <hr/>
            <p class="text-center mb-0">Don't have an account? <a href="/signup.html">Create one here</a></p>
        </div>
    </div>
</body>
</html>
